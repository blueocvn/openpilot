# Dependency-only image for running openpilot + the tools/sim CARLA bridge.
# The source tree is NOT copied in: it is bind-mounted at runtime, and the Python
# environment / scons outputs are created inside the mounted tree (see run.sh).
#
#   docker build -t openpilot-sim:local -f openpilot/tools/sim/docker/Dockerfile.openpilot openpilot/tools/sim/docker
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git git-lfs build-essential clang pkg-config \
    libgl1 libegl1 libgles2 libglu1-mesa libx11-6 libxcursor1 libxi6 libxinerama1 libxrandr2 \
    libxkbcommon0 libvulkan1 libportaudio2 libusb-1.0-0 libgomp1 libglib2.0-0t64 \
    libdbus-1-3 libasound2t64 xdg-user-dirs procps \
  && rm -rf /var/lib/apt/lists/*

# uv downloads the Python version pinned by .python-version on first sync
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# a user matching the host uid, so files built into the mounted tree are owned by you
# (ubuntu:24.04 ships an "ubuntu" user on uid 1000: drop it first)
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN (userdel -r ubuntu || true) && (groupdel ubuntu || true) \
 && groupadd -g ${GROUP_ID} sim && useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash sim

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute,display \
    SHELL=/bin/bash
