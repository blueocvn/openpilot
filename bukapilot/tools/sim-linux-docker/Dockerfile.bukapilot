# Dependency-only image for running bukapilot (openpilot 0.8.13 base) in CARLA.
# The source tree is NOT copied in: it is bind-mounted at runtime and built with scons
# inside the container (see start_docker.sh).
#
# Build (from the bukapilot root):
#   docker build -t bukapilot-sim:local -f tools/sim-linux-docker/Dockerfile.bukapilot .
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# same package set as tools/ubuntu_setup.sh (Ubuntu 20.04 branch), plus sim/runtime extras
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf build-essential ca-certificates clang cmake make cppcheck libtool \
    gcc-arm-none-eabi bzip2 liblzma-dev libarchive-dev libbz2-dev capnproto libcapnp-dev \
    curl libcurl4-openssl-dev git git-lfs ffmpeg libavformat-dev libavcodec-dev \
    libavdevice-dev libavutil-dev libavfilter-dev libavresample-dev libeigen3-dev libffi-dev \
    libglew-dev libgles2-mesa-dev libglfw3-dev libglib2.0-0 libomp-dev libopencv-dev \
    libpng16-16 libssl-dev libsqlite3-dev libusb-1.0-0-dev libzmq3-dev libsystemd-dev \
    locales opencl-headers ocl-icd-libopencl1 ocl-icd-opencl-dev clinfo \
    python3 python3-dev python3-pip python3-distutils python-is-python3 \
    qml-module-qtquick2 qtmultimedia5-dev qtlocation5-dev qtpositioning5-dev \
    libqt5sql5-sqlite libqt5svg5-dev libqt5x11extras5-dev qt5-default \
    libreadline-dev libdw1 valgrind \
    tmux vim dbus libx11-6 pocl-opencl-icd \
  && locale-gen en_US.UTF-8 \
  && dbus-uuidgen > /etc/machine-id \
  && rm -rf /var/lib/apt/lists/*

# NVIDIA OpenCL ICD (libnvidia-opencl is injected by the nvidia container runtime)
RUN mkdir -p /etc/OpenCL/vendors && echo "libnvidia-opencl.so.1" > /etc/OpenCL/vendors/nvidia.icd

# python deps pinned by bukapilot's Pipfile.lock (Ubuntu 20.04 python3 == 3.8.10 == .python-version).
# onnxruntime-gpu==1.10.0 has been removed from PyPI (and its CUDA 11 build wouldn't support
# RTX 50-series anyway), so it is swapped for the CPU build of the same version.
COPY Pipfile.lock /tmp/pip/
RUN python3 -m pip install --no-cache-dir pip==21.3.1 \
 && python3 -c "import json; d=json.load(open('/tmp/pip/Pipfile.lock'))['default']; \
open('/tmp/pip/req.txt','w').write(''.join(f\"{k}{v['version']}\" + (f\"; {v['markers']}\" if 'markers' in v else '') + '\n' \
for k,v in d.items() if k != 'onnxruntime-gpu' and 'version' in v))" \
 && python3 -m pip install --no-cache-dir -r /tmp/pip/req.txt onnxruntime==1.10.0 carla==0.9.12 \
 && rm -rf /tmp/pip /root/.cache

# a user matching the host uid, so files built into the mounted tree are owned by you
# (and Python's Path.home() works; scons strips $HOME from its subprocess env)
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} sim && useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash sim

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute \
    QTWEBENGINE_DISABLE_SANDBOX=1 \
    QT_X11_NO_MITSHM=1 \
    PYOPENCL_CTX=0 \
    SHELL=/bin/bash
