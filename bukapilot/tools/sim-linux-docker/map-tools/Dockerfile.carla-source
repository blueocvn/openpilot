# Build environment for CARLA 0.9.15 from source (Unreal Engine 4.26, CARLA fork) and the Unreal Editor.
# The CARLA 0.9.15 docs target Ubuntu 18.04/20.04 with clang-10; the host is newer, so the toolchain lives here and the
# sources stay on the host (/home/ubuntu/carla-src, mounted at the same path by editor.sh, which builds this image):
#   docker build -t carla-source:0.9.15 --build-arg UID=$(id -u) --build-arg GID=$(id -g) \
#     -f Dockerfile.carla-source .
FROM ubuntu:20.04

ARG UID=1000
ARG GID=1000
ARG USER=ubuntu
ENV DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC

# Packages of the CARLA 0.9.15 Linux build guide (Ubuntu 20.04; python/python-dev are python2 on focal),
# plus the X11 and Vulkan libs the editor window loads at runtime, and sudo for scripts that install prerequisites.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang-10 lld-10 g++-7 cmake ninja-build libvulkan1 \
    python2 python-is-python2 python2-dev python3-dev python3-pip \
    libpng-dev libtiff5-dev libjpeg-dev tzdata sed curl wget unzip autoconf libtool rsync libxml2-dev git \
    ca-certificates sudo xdg-user-dirs xdg-utils \
    libxcursor1 libxi6 libxinerama1 libxss1 libxrandr2 libxxf86vm1 libsm6 libxtst6 libnss3 libgtk-3-0 \
 && rm -rf /var/lib/apt/lists/* \
 && update-alternatives --install /usr/bin/clang++ clang++ /usr/lib/llvm-10/bin/clang++ 180 \
 && update-alternatives --install /usr/bin/clang clang /usr/lib/llvm-10/bin/clang 180

# not in the CARLA guide's list, but patchelf's autoreconf (run by make launch -> Setup.sh) needs aclocal
RUN apt-get update && apt-get install -y --no-install-recommends automake vulkan-tools libgl1 libglu1-mesa \
 && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir -Iv setuptools==47.3.1 && pip3 install --no-cache-dir distro wheel auditwheel

# same uid/gid as the host user, so files written to the mounted sources belong to them
RUN groupadd -g "$GID" "$USER" && useradd -m -u "$UID" -g "$GID" -s /bin/bash "$USER" \
 && echo "$USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/"$USER"
USER $USER
